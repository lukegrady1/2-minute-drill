{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@engine/*": ["./engine/*"], "@config": ["./config/tuning.json"] },
    "baseUrl": "."
  },
  "include": ["engine/**/*.ts", "web/src/**/*.ts", "config/tuning.json"]
}
